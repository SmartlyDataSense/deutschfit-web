# DeutschFit web — local environment template.
#
# Copy this file to `.env.local` and fill in real values. Do NOT commit
# `.env.local`. The CI workflow (.github/workflows/ci.yml) injects
# placeholders for the NEXT_PUBLIC_* vars so the build can run without
# secrets — runtime wiring (Supabase, Resend, payment toggles) lives here.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined at build time and exposed
# to the browser. Anything sensitive must NOT use that prefix.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dev backend for learner app development. Project URL + publishable (anon) key.
# Safe to expose to the browser. Use dev project credentials for local testing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Service-role key. Bypasses RLS — server-only, never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Web Push (S12) ──────────────────────────────────────────────────────────
# VAPID PUBLIC key (safe to expose — it is by definition public; the
# matching PRIVATE key lives ONLY in Supabase function secrets). When
# unset, the notifications toggle renders as "not available" — the app
# never crashes on a missing key. Value: the VAPID_PUBLIC_KEY set on the
# dev Supabase project (see deutschfit-backend scripts/generate-vapid-keys.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Resend (transactional email) ────────────────────────────────────────────
# RESEND_API_KEY is server-only. The activation-email helper throws
# EmailNotConfiguredError if it's unset (so W4 surfaces it cleanly).
RESEND_API_KEY=re_your_api_key

# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin used for absolute URLs (magic-link callbacks, OG images, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── PostHog analytics ────────────────────────────────────────────────────────
# Consumer: src/learner/core/analytics/posthog.ts (getPostHogKey/getPostHogHost).
# Missing key => every analytics export becomes a silent no-op (safe default
# for local dev / CI / Vitest — no client is constructed, no network touched).
NEXT_PUBLIC_POSTHOG_KEY=
# Default when unset (documented in posthog.ts's getPostHogHost) — EU region
# so learner event data doesn't leave the EU by default.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── E2E tests — onboarding gate (S13) ────────────────────────────────────────
# Consumer: tests/e2e/learner-onboarding-gate.spec.ts. Credentials for a
# dedicated test account that has NOT completed onboarding yet — the spec
# skips itself when either var is unset (see the file's header comment for
# how to reset the account's onboarding-done flag between runs).
E2E_ONBOARDING_GATE_EMAIL=
E2E_ONBOARDING_GATE_PASSWORD=

# ─── Operator payment handles (public; rendered on /how-to-pay) ──────────────
# These show up on the public /how-to-pay page so a learner can pay
# out-of-band before the operator activates their plan. NEXT_PUBLIC_*
# because the page is statically rendered (with revalidation) and the
# values aren't secrets — they're public phone numbers / handles. Leave
# any unset and the channel renders a "Coming soon" placeholder.
NEXT_PUBLIC_PAY_MOMO_NUMBER=
NEXT_PUBLIC_PAY_OM_NUMBER=
NEXT_PUBLIC_PAY_BANK_DETAILS=
NEXT_PUBLIC_PAY_PAYPAL_HANDLE=
NEXT_PUBLIC_PAY_WISE_HANDLE=
NEXT_PUBLIC_PAY_EMAIL=support@deutschfit.app
